# ==============================================================================
# HR PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Sao chép file này thành .env và điền các giá trị bí mật của môi trường bạn:
# cp .env.example .env
# ==============================================================================

# Database Connection (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hr_portal
DB_USER=hr_user
DB_PASSWORD=your_secure_db_password
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Database=hr_portal;User=hr_user;Password=your_secure_db_password;Convert Zero Datetime=True;Allow Zero Datetime=True;Pooling=true;Min Pool Size=5;Max Pool Size=100;Connection Lifetime=300;

# JWT Authentication (Khóa tối thiểu 256-bit ngẫu nhiên)
JWT_KEY=your_256_bit_secure_random_jwt_secret_key_here
JWT_ISSUER=HR.API
JWT_AUDIENCE=HR.Frontend
JWT_EXPIRY_HOURS=24

# Data Encryption Key (Khóa mã hóa đối xứng AES-256)
ENCRYPTION_KEY=your_256_bit_secure_aes_encryption_key_here

# Payment Webhook Secret (Xác thực chữ ký HMAC / Webhook)
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_key_here

# Google Gemini AI Integration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# SMTP Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@domain.com
SMTP_FROM_NAME=HR Portal - Ban Tuyển Dụng

# Production Admin Seed Password (Chỉ áp dụng khi khởi tạo production)
# ADMIN_SEED_PASSWORD=YourStrongAdminPassword123!
